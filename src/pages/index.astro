---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import portrait from "../assets/calin-gabriel-portrait.jpg";
import { projects } from "../data/projects";
import { siteRole } from "../data/site";

const email = "contact@calingabriel.com";
const mailto = `mailto:${email}?subject=Backend%20work%20(Node%2FTS)`;

const approach = [
  {
    n: "BACKEND",
    title: "Backend work in regulated systems",
    body: "At Bitpanda I owned the crypto address book: the API, the data model, the validation rules, the tests and the release. In custody, an address accepted by mistake can mean funds nobody gets back, so most of the work sat in the validation and the failure cases rather than the happy path.",
    evidence: "Bitpanda — institutional crypto custody for banks.",
  },
  {
    n: "MIGRATION",
    title: "Legacy Java into Node and NestJS",
    body: "At RWE we moved legacy Java components to NestJS in slices, with integration and E2E tests around each slice, so day-to-day delivery could keep going while the migration ran underneath it. Small team, live production system, no appetite for a full rewrite.",
    evidence: "RWE — Java to NestJS on an energy-market platform.",
  },
  {
    n: "PERFORMANCE",
    title: "APIs and data access that got slow",
    body: "I profile before changing anything. At RWE that meant finding the real bottleneck in MongoDB aggregations serving about 15,000 queries a day, then moving CPU-heavy exports onto Node worker pools so they stopped blocking normal API work.",
    evidence: "RWE — around 65% faster API responses; exports from 45 minutes to 12.",
  },
  {
    n: "PRODUCT",
    title: "Product work across React and Node",
    body: "React and Node in the same week, usually with somebody else's platform in the middle. At ImmoScout24 that was Iterable wired into lifecycle messaging — mostly mapping their data model onto ours and making the failure modes visible. The platform was tested at every layer and matching that bar took me a while.",
    evidence: "ImmoScout24 — Iterable lifecycle integration, plus search, listing and SEO across React and Node.",
  },
];

const ledger = [
  { v: "45 → 12 min", k: "RWE export pipeline, moved to worker pools" },
  { v: "≈ 65%", k: "faster API responses after migration" },
  { v: "15,000+/day", k: "energy-market queries served" },
  { v: "2,000+/day", k: "documents through a React + Node pipeline (Endava)" },
];

const trajectory = [
  {
    label: "Start",
    title: "First job at 16.",
    body: "I won an internship contest in Galați and turned it into my first software job, doing Linux and web work on things people actually used. Computer Science at Babeș-Bolyai came after, and mostly it put names to things I had already been doing.",
  },
  {
    label: "Since",
    title: "Backend, mostly in data-heavy or regulated products.",
    body: "DeverSoft, WIP Romania, Endava, RWE, ImmoScout24, Bitpanda. Restaurant systems, a wallet, scientific publishing, payments, energy-market data, property listings, and most recently crypto custody. Node and TypeScript throughout, with enough React that I can work on both sides of a product.",
  },
  {
    label: "Next",
    title: "What I am looking for.",
    body: "Remote in the EU or hybrid in Cluj, contract or permanent. I would like to stay somewhere long enough to actually learn the domain, on a team that owns what it builds.",
  },
];

const statusLabel = {
  LIVE: "Live",
  ENTERPRISE: "Enterprise",
  AGENCY: "Agency",
  FINTECH: "Fintech",
};
---

<BaseLayout
  title={`Calin Gabriel - ${siteRole}`}
  description="Backend developer in Cluj-Napoca, working in Node.js and TypeScript. Most recently on Bitpanda's crypto custody platform for banks; before that ImmoScout24 and RWE. Open to remote EU or Cluj, contract or permanent."
>
  <!-- MASTHEAD -->
  <header class="masthead" id="top">
    <div class="masthead-rule"></div>
    <div class="masthead-inner">
      <a class="mast-id" href="#top">
        <span class="mast-name">Calin Gabriel</span>
        <span class="mast-role">{siteRole}</span>
      </a>

      <nav class="mast-nav" aria-label="Sections">
        <a href="#approach">Work</a>
        <a href="#trajectory">Background</a>
        <a href="#casefiles">Projects</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="mast-actions">
        <span class="mast-status" aria-label="Availability">
          <span class="status-dot"></span> Available
        </span>
        <ThemeToggle />
      </div>
    </div>
    <div class="masthead-rule thin"></div>
  </header>

  <main class="sheet">
    <!-- LEDE / HERO -->
    <section class="lede" aria-labelledby="lede-title">
      <div class="lede-identity">
        <span class="portrait-seal">
          <Image
            src={portrait}
            alt="Portrait of Calin Gabriel"
            width={320}
            height={320}
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </span>
        <p class="kicker">Cluj-Napoca · remote EU or hybrid · contract or permanent</p>
      </div>

      <h1 class="lede-title" id="lede-title">
        Backend developer,<br />
        Cluj-Napoca.<br />
        Node and <span>TypeScript</span>.
      </h1>

      <div class="lede-columns">
        <p class="lede-body">
          Most recently I worked on the
          <strong>crypto custody platform Bitpanda builds for banks</strong>, where I owned
          the address book — the part that checks an address is valid before a customer's
          funds can be sent to it. Before that, ImmoScout24 in Austria and RWE in Germany,
          both long-running platforms that had to keep working while they changed. Backend
          is where I'm strongest, but I've shipped the React side of the same products and
          the integrations sitting between them.
        </p>
        <p class="lede-sub">
          I ask a lot of questions when I join something new.
        </p>
      </div>

      <div class="lede-cta">
        <a href={mailto} class="btn btn-ink">Email me</a>
        <a href="#approach" class="btn btn-line">What I work on</a>
        <a href="/resume" class="btn btn-line">CV</a>
      </div>
    </section>

    <!-- LEDGER / METRICS -->
    <section class="ledger" aria-label="Numbers from past projects">
      <span class="ledger-tag">A few numbers</span>
      <dl class="ledger-grid">
        {ledger.map((item) => (
          <div class="ledger-row">
            <dt>{item.v}</dt>
            <dd>{item.k}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- APPROACH -->
    <section class="approach" id="approach" aria-labelledby="approach-title">
      <div class="section-head">
        <span class="section-no">Work</span>
        <h2 id="approach-title">What I work on.</h2>
        <p class="section-lede">
          Roughly four areas, with the project each one comes from.
        </p>
      </div>

      <ol class="approach-list">
        {approach.map((item) => (
          <li class="approach-item">
            <span class="approach-no">{item.n}</span>
            <div class="approach-body">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <p class="approach-evidence"><span>Project</span> {item.evidence}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- TRAJECTORY -->
    <section class="trajectory" id="trajectory" aria-labelledby="trajectory-title">
      <div class="section-head">
        <span class="section-no">Background</span>
        <h2 id="trajectory-title">How I got here.</h2>
      </div>

      <div class="traj-list">
        {trajectory.map((phase) => (
          <article class="traj-item">
            <div class="traj-meta">
              <span class="traj-label">{phase.label}</span>
            </div>
            <div class="traj-content">
              <h3>{phase.title}</h3>
              <p>{phase.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="casefiles" id="casefiles" aria-labelledby="casefiles-title">
      <div class="section-head">
        <span class="section-no">Projects</span>
        <h2 id="casefiles-title">Projects.</h2>
        <p class="section-lede">Four of them, with what I actually did on each.</p>
      </div>

      <div class="case-list">
        {projects.map((project, i) => (
          <a href={`/projects/${project.id}`} class="case">
            <span class="case-index">{String(i + 1).padStart(2, "0")}</span>
            <div class="case-main">
              <div class="case-top">
                <h3>{project.homeTitle}</h3>
                <span class:list={["case-status", `is-${project.status.toLowerCase()}`]}>
                  {statusLabel[project.status]}
                </span>
              </div>
              <p class="case-summary">{project.caseStudySummary}</p>
              <div class="case-tech">
                {project.tech.map((t) => <span class="mono-pill">{t}</span>)}
              </div>
            </div>
            <ul class="case-results">
              {project.results.map((r) => <li>{r}</li>)}
            </ul>
            <span class="case-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- COLOPHON / CONTACT -->
    <footer class="colophon" id="contact">
      <div class="colophon-rule"></div>
      <div class="colophon-grid">
        <div class="colophon-lead">
          <h2>Get in touch.</h2>
          <a href={mailto} class="btn btn-ink">Email me</a>
        </div>
        <dl class="colophon-meta">
          <div><dt>Email</dt><dd><a href={mailto}>{email}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href="https://github.com/calindotgabriel" rel="me">/calindotgabriel</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/calingabriel-ts-dev/" rel="me">/calingabriel-ts-dev</a></dd></div>
          <div><dt>Engagement</dt><dd>Permanent or B2B · remote EU or Cluj · available now</dd></div>
        </dl>
      </div>
      <p class="colophon-sign">
        Set in Geologica, Atkinson &amp; Martian Mono.
        © {new Date().getFullYear()} Calin Gabriel.
      </p>
    </footer>
  </main>

  <style>
    :global(body) { padding-top: 0; }

    .sheet {
      position: relative;
      z-index: 2;
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 5vw, 4rem);
    }

    /* ---------- Masthead ---------- */
    .masthead {
      position: sticky;
      top: 0;
      z-index: 50;
      background: color-mix(in srgb, var(--page-bg) 88%, transparent);
      backdrop-filter: blur(8px) saturate(1.1);
    }
    .masthead-rule { height: 3px; background: var(--secondary); }
    .masthead-rule.thin { height: 1px; background: var(--border-strong); }
    .masthead-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0.7rem clamp(1.25rem, 5vw, 4rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .mast-id { text-decoration: none; color: var(--text); display: flex; flex-direction: column; line-height: 1.15; }
    .mast-name { font-family: var(--font-display); font-weight: 670; font-size: 1.18rem; letter-spacing: -0.025em; }
    .mast-role { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }

    .mast-nav { display: flex; gap: 1.6rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; }
    .mast-nav a { text-decoration: none; color: var(--text-muted); text-transform: uppercase; transition: color 0.2s ease; position: relative; padding-bottom: 2px; }
    .mast-nav a:hover { color: var(--text); }
    .mast-nav a::after { content: ""; position: absolute; left: 0; bottom: -2px; height: 1px; width: 0; background: var(--secondary); transition: width 0.25s ease; }
    .mast-nav a:hover::after { width: 100%; }
    .mast-actions { display: flex; align-items: center; gap: 1rem; }
    .mast-status { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #1f9d6b; }

    /* ---------- Lede / hero ---------- */
    .lede { padding: clamp(4rem, 9vw, 7.5rem) 0 clamp(3rem, 6vw, 5rem); }
    .lede-identity { display: flex; align-items: center; gap: 0.95rem; margin-bottom: 1.35rem; }
    .portrait-seal {
      display: block;
      flex: 0 0 76px;
      width: 76px;
      height: 76px;
      box-sizing: border-box;
      overflow: hidden;
      padding: 3px;
      border: 2px solid var(--secondary);
      border-radius: 50%;
      background: var(--page-bg);
    }
    .portrait-seal :global(img) { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
    .kicker { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.075em; text-transform: uppercase; color: var(--secondary); margin: 0; }

    .lede-title {
      font-family: var(--font-display);
      font-weight: 690;
      font-size: clamp(2.7rem, 6.8vw, 5.7rem);
      line-height: 0.96;
      letter-spacing: -0.05em;
      color: var(--text);
      margin: 0 0 2.4rem;
      max-width: 17ch;
    }
    .lede-title span { color: var(--secondary); }

    .lede-columns {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      max-width: 920px;
      margin-bottom: 2.6rem;
    }
    .lede-body { font-size: 1.18rem; line-height: 1.6; color: var(--text); max-width: none; }
    .lede-body strong { font-weight: 700; border-bottom: 2px solid color-mix(in srgb, var(--secondary) 45%, transparent); }
    .lede-sub { font-size: 1.02rem; line-height: 1.65; color: var(--text-muted); border-left: 2px solid var(--secondary); padding-left: 1.1rem; max-width: none; }

    .lede-cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }

    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase;
      text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 2px; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .btn-ink { background: var(--secondary); color: #fff; border: 1px solid var(--secondary); }
    .btn-ink:hover { background: var(--text); border-color: var(--text); color: var(--page-bg); }
    .btn-line { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
    .btn-line:hover { border-color: var(--secondary); color: var(--secondary); }

    /* ---------- Ledger ---------- */
    .ledger { border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border-strong); padding: 2.2rem 0 2.4rem; margin-bottom: clamp(3rem, 7vw, 6rem); }
    .ledger-tag { display: block; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.075em; text-transform: uppercase; color: var(--secondary); margin-bottom: 1.2rem; }
    .ledger-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 2.4rem; margin: 0; }
    .ledger-row { display: grid; grid-template-columns: minmax(7.5rem, auto) 1fr; gap: 1rem; align-items: baseline; border-top: 1px solid var(--border); padding: 0.9rem 0; }
    .ledger-row dt { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1; letter-spacing: -0.025em; color: var(--text); }
    .ledger-row dd { font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.5; color: var(--text-muted); margin: 0; }

    /* ---------- Section heads ---------- */
    .section-head { max-width: 760px; margin-bottom: clamp(2.2rem, 5vw, 3.4rem); }
    .section-no { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.075em; text-transform: uppercase; color: var(--secondary); display: block; margin-bottom: 1rem; }
    .section-head h2 { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.9rem, 4.4vw, 3.1rem); line-height: 1.05; letter-spacing: -0.04em; color: var(--text); margin-bottom: 1.1rem; }
    .section-lede { font-size: 1.12rem; line-height: 1.6; color: var(--text-muted); }

    section { padding-block: clamp(3rem, 7vw, 6rem); }
    /* The hero and ledger carry their own vertical rhythm. This used to read
       `padding-block: revert`, which has the same specificity as .lede's own
       padding rule above and therefore zeroed it out. */
    .lede { padding-block: clamp(1.5rem, 3vw, 2.75rem) clamp(3rem, 6vw, 5rem); }
    .ledger { padding-block: 2.2rem 2.4rem; }

    /* ---------- Approach ---------- */
    .approach-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
    .approach-item { display: grid; grid-template-columns: 7rem 1fr; gap: clamp(1rem, 3vw, 2.5rem); padding: 0; border-top: 1px solid var(--border-strong); }
    .approach-item:last-child { border-bottom: 1px solid var(--border-strong); }
    .approach-no { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.04em; color: var(--secondary); padding-top: 2.45rem; }
    .approach-body { position: relative; border-left: 2px solid var(--border-strong); padding: 2rem 0 2rem clamp(1.4rem, 3vw, 2.5rem); }
    .approach-body::before { content: ""; position: absolute; top: 2.55rem; left: -6px; width: 8px; height: 8px; border: 2px solid var(--secondary); border-radius: 50%; background: var(--page-bg); }
    .approach-body h3 { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.3rem, 2.6vw, 1.85rem); letter-spacing: -0.025em; margin-bottom: 0.7rem; color: var(--text); }
    .approach-body > p { font-size: 1.08rem; line-height: 1.62; color: var(--text-muted); max-width: 64ch; margin-bottom: 0.9rem; }
    .approach-evidence { font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.5; color: var(--text); margin: 0; }
    .approach-evidence span { color: var(--secondary); text-transform: uppercase; letter-spacing: 0.08em; margin-right: 0.5rem; }

    /* ---------- Trajectory ---------- */
    .traj-list { display: grid; gap: 0; }
    .traj-item { display: grid; grid-template-columns: 14rem 1fr; gap: clamp(1rem, 3vw, 3rem); padding: 2.2rem 0; border-top: 1px solid var(--border); }
    .traj-item:first-child { border-top: 1px solid var(--border-strong); }
    .traj-meta { display: flex; flex-direction: column; gap: 0.4rem; }
    .traj-label { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text); }
    .traj-content { border-left: 2px solid var(--border-strong); padding-left: clamp(1.2rem, 3vw, 2rem); }
    .traj-content h3 { font-family: var(--font-display); font-weight: 630; font-size: clamp(1.4rem, 3vw, 2.05rem); line-height: 1.12; letter-spacing: -0.03em; margin-bottom: 0.8rem; color: var(--text); }
    .traj-content p { font-size: 1.08rem; line-height: 1.68; color: var(--text-muted); max-width: 62ch; }

    /* ---------- Projects ---------- */
    .case-list { display: grid; gap: 0; }
    .case {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1.6fr) minmax(0, 0.9fr) 1.5rem;
      gap: clamp(1rem, 3vw, 2.5rem);
      align-items: start;
      padding: 2.2rem 0;
      border-top: 1px solid var(--border-strong);
      text-decoration: none;
      color: inherit;
      position: relative;
      transition: padding-left 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    .case:last-child { border-bottom: 1px solid var(--border-strong); }
    .case::before { content: ""; position: absolute; left: -1.5rem; top: 0; bottom: 0; width: 2px; background: var(--secondary); transform: scaleY(0); transform-origin: top; transition: transform 0.3s ease; }
    .case:hover { padding-left: 0.6rem; }
    .case:hover::before { transform: scaleY(1); }
    .case-index { font-family: var(--font-mono); font-size: 0.82rem; color: var(--secondary); padding-top: 0.5rem; }
    .case-top { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 0.7rem; }
    .case-top h3 { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.25rem, 2.4vw, 1.7rem); letter-spacing: -0.025em; margin: 0; color: var(--text); }
    .case-status { font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.18rem 0.5rem; border-radius: 2px; border: 1px solid var(--border-strong); color: var(--text-muted); white-space: nowrap; }
    .case-status.is-live { color: #1f9d6b; border-color: color-mix(in srgb, #1f9d6b 40%, transparent); }
    .case-status.is-enterprise { color: var(--secondary); border-color: color-mix(in srgb, var(--secondary) 40%, transparent); }
    .case-status.is-fintech { color: var(--secondary); border-color: color-mix(in srgb, var(--secondary) 40%, transparent); }
    .case-summary { font-size: 1.04rem; line-height: 1.62; color: var(--text-muted); margin-bottom: 1rem; max-width: 56ch; }
    .case-tech { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .mono-pill { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; color: var(--text); border: 1px solid var(--border-strong); border-radius: 2px; padding: 0.22rem 0.55rem; }
    .case-results { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
    .case-results li { font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.4; color: var(--text-muted); padding-left: 1rem; position: relative; }
    .case-results li::before { content: "→"; position: absolute; left: 0; color: var(--secondary); }
    .case-arrow { font-size: 1.3rem; color: var(--text-subtle); padding-top: 0.3rem; transition: transform 0.3s ease, color 0.2s ease; }
    .case:hover .case-arrow { transform: translate(4px, -4px); color: var(--secondary); }

    /* ---------- Colophon ---------- */
    .colophon { padding-bottom: 4rem; }
    .colophon-rule { height: 3px; background: var(--secondary); margin-bottom: 2.6rem; }
    .colophon-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: start; margin-bottom: 3rem; }
    .colophon-grid > * { min-width: 0; }
    .colophon-lead h2 { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.06; letter-spacing: -0.035em; margin-bottom: 1.6rem; color: var(--text); max-width: 18ch; }
    .colophon-meta { display: grid; gap: 0; margin: 0; }
    .colophon-meta > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--border); }
