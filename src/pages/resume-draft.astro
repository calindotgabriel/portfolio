---
import RuntimeDossierDocument from "../components/RuntimeDossierDocument.astro";
import RuntimeDossierLayout from "../layouts/RuntimeDossierLayout.astro";
import {
  runtimeDossierDescription,
  runtimeDossierPersonJsonLd,
  runtimeDossierTitle,
} from "../data/runtimeDossierSeo";
---

<RuntimeDossierLayout
  title={runtimeDossierTitle}
  description={runtimeDossierDescription}
  personJsonLd={runtimeDossierPersonJsonLd}
  canonicalUrl="https://calingabriel.com/resume-draft"
  robots="noindex, nofollow"
>
  <RuntimeDossierDocument
    statusLabel="Isolated draft · not linked"
    downloadHref="/cv-runtime-dossier.pdf"
    downloadName="Calin_Gabriel_Runtime_Dossier_CV.pdf"
    downloadLabel="Download draft PDF"
  />
</RuntimeDossierLayout>
