---
import ProjectLayout from "../../components/ProjectLayout.astro";

const sections = [
  {
    no: "",
    title: "The problem",
    body: [
      "ImmoScout24 is one of the most-used real-estate platforms in Austria and part of the wider Scout24 group. The work sat inside a mature distributed system: search and listing flows, SEO-sensitive pages, marketing automation, and integration points that had to keep working under normal product-delivery pressure.",
      "The existing system already had strong unit, integration, and e2e coverage. My contribution was not a rewrite — it was getting productive in that environment, making targeted changes, and matching the team's expectations for testing, review quality, and production safety.",
    ],
  },
  {
    no: "",
    title: "My biggest challenge",
    body: [
      "The steepest learning curve was adapting to the quality expectations of a DAX-listed engineering organization. The codebase was tested at every layer across distributed services, with SSO federated from Scout24's German platform. Small changes still required clear reasoning, good coverage, and careful review.",
      "I had to level up my testing discipline, communicate more precisely with senior engineers, and learn when to sync with my mentor. That calibration mattered: ask too early and you create noise; wait too long and you block delivery.",
    ],
  },
];

const delivered = [
  { n: "01", h: "Iterable lifecycle integration", p: "Integrated Iterable into the React and Node.js product flows: mapping platform data onto Iterable's data model, feeding the events lifecycle messaging depends on, and handing marketing the ability to run targeted campaigns without engineering in the loop for every change." },
  { n: "02", h: "Search and listing flows", p: "Shipped focused improvements across React and Node.js in search and listing, reviewed against an existing product and testing culture rather than a greenfield codebase." },
  { n: "03", h: "SEO-sensitive delivery", p: "Worked on technical SEO where page structure, rendering behaviour, and release quality had direct product impact. The team tracked organic visibility closely, so regressions had to be avoided." },
  { n: "04", h: "Enricher task upgrades", p: "Upgraded the functional-style enricher tasks that process and transform property data — improving reliability and maintainability of the data pipeline." },
];

const stack = ["React", "Hapi.js", "Node.js", "MongoDB", "AWS", "Iterable"];
---

<ProjectLayout
  title="ImmoScout24 Austria — Search Platform"
  description="Case study: integrating Iterable into lifecycle messaging and shipping search, listing and SEO work across React and Node inside a fully tested distributed real-estate platform."
>
  <div class="ed-wrap">
    <section class="ed-hero">
      <p class="ed-kicker">
        <a href="/projects">← Projects</a>
      </p>
      <h1>ImmoScout24 Austria</h1>
      <p class="ed-hero-lead">Iterable lifecycle integration, plus search, listing and SEO work across React and Node, inside a tested distributed real-estate platform.</p>
      <div class="ed-hero-meta">
        <span class="ed-status is-live">Live</span>
      </div>
    </section>

    {sections.map((s) => (
      <section class="ed-section">
        <div class="ed-section-grid">
          <span class="ed-section-no">{s.no}</span>
          <div>
            <h2 class="ed-h2">{s.title}</h2>
            {s.body.map((p) => <p class="ed-body" set:html={p} />)}
          </div>
        </div>
      </section>
    ))}

    <section class="ed-section">
      <div class="ed-section-grid">
        <span class="ed-section-no"></span>
        <div>
          <h2 class="ed-h2">What I delivered</h2>
          <div class="ed-cards">
            {delivered.map((d) => (
              <div class="ed-card">
                <span class="ed-card-no">{d.n}</span>
                <h3>{d.h}</h3>
                <p>{d.p}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="ed-section">
      <div class="ed-section-grid">
        <span class="ed-section-no"></span>
        <div>
          <h2 class="ed-h2">What changed</h2>
          <p class="ed-body">The impact was practical: targeted search, listing, and SEO changes shipped inside a mature production platform, while the Iterable integration reduced the engineering dependency for campaign setup. Exact commercial metrics aren't mine to disclose, so the public proof stays with the systems and delivery scope I can substantiate.</p>
        </div>
      </div>
    </section>

    <section class="ed-section">
      <div class="ed-section-grid">
        <span class="ed-section-no"></span>
        <div>
          <h2 class="ed-h2">What I took away</h2>
          <p class="ed-body">This project reset my default expectations for test coverage and review quality. Having tests at every layer did not remove the need for judgment, but it did make smaller, better-scoped changes easier to justify.</p>
          <p class="ed-body">On the human side, I learned when to reach out to a mentor and when to push through on my own. I still use that calibration when I join a team.</p>
        </div>
      </div>
    </section>

    <section class="ed-section">
      <div class="ed-section-grid">
        <span class="ed-section-no"></span>
        <div>
          <h2 class="ed-h2">Stack</h2>
          <div class="ed-stack">
            {stack.map((t) => <span class="mono-pill">{t}</span>)}
          </div>
        </div>
      </div>
    </section>
  </div>
</ProjectLayout>
