---
import RuntimeResumeDocument from "../components/RuntimeResumeDocument.astro";
import RuntimeDossierLayout from "../layouts/RuntimeDossierLayout.astro";
import {
  runtimeDossierDescription,
  runtimeDossierPersonJsonLd,
  runtimeDossierTitle,
} from "../data/runtimeDossierSeo";
---

<RuntimeDossierLayout
  title={runtimeDossierTitle}
  description={runtimeDossierDescription}
  personJsonLd={runtimeDossierPersonJsonLd}
  canonicalUrl="https://calingabriel.com/resume"
>
  <RuntimeResumeDocument
    statusLabel="CV · Cluj-Napoca"
    downloadHref="/cv.pdf"
    downloadName="Calin_Gabriel_CV.pdf"
    downloadLabel="Download PDF"
  />
</RuntimeDossierLayout>
