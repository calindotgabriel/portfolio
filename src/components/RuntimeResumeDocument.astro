---
import { resumeDraft } from "../data/resumeDraft";
import "../styles/runtime-resume.css";

export interface Props {
  statusLabel: string;
  downloadHref: string;
  downloadName: string;
  downloadLabel: string;
}

const { statusLabel, downloadHref, downloadName, downloadLabel } = Astro.props;
const recentExperience = resumeDraft.experience.filter((job) => job.onePageHighlights);
const earlierExperience = resumeDraft.experience.filter((job) => job.compactSummary);
const formatPeriod = (period: string) => period.replace(" - ", "\n- ");
---

<div class="runtime-actions" aria-label="CV actions">
  <span class="runtime-badge">{statusLabel}</span>
  <a
    href={downloadHref}
    download={downloadName}
    class="runtime-download"
    id="download-runtime-pdf"
  >{downloadLabel}</a>
</div>

<main class="runtime-document" aria-label="Calin Gabriel one-page CV">
  <section class="runtime-page" aria-labelledby="runtime-name">
    <header class="runtime-header">
      <div>
        <p class="runtime-eyebrow">Curriculum vitae · July 2026</p>
        <h1 id="runtime-name">Calin Gabriel</h1>
        <p class="runtime-title">{resumeDraft.title}</p>
      </div>

      <address class="runtime-contact">
        <p><span>Based in</span>{resumeDraft.locationDetail}</p>
        <p><span>Email</span><a href={`mailto:${resumeDraft.email}`}>{resumeDraft.email}</a></p>
        <p><span>Phone</span><a href={`tel:${resumeDraft.phone.replace(/\s/g, "")}`}>{resumeDraft.phone}</a></p>
        <p>
          <span>Web</span>
          <a href={resumeDraft.website}>{resumeDraft.websiteDisplay}</a>
          <span class="runtime-contact-separator">·</span>
          <a href={resumeDraft.linkedin}>LinkedIn</a>
          <span class="runtime-contact-separator">·</span>
          <a href={resumeDraft.github}>GitHub</a>
        </p>
      </address>
    </header>

    <p class="runtime-summary">{resumeDraft.onePageSummary}</p>

    <dl class="runtime-proof-grid" aria-label="Selected results">
      {resumeDraft.proofs.map((proof) => (
        <div>
          <dt>{proof.value}</dt>
          <dd>{proof.label}</dd>
        </div>
      ))}
    </dl>

    <section class="runtime-career" aria-labelledby="career-runtime">
      <div class="runtime-career-head">
        <h2 id="career-runtime">Work experience</h2>
        <p>Most recent first</p>
      </div>

      <div class="runtime-timeline">
        {recentExperience.map((job) => (
          <article class="runtime-entry">
            <time datetime={`${job.start}/${job.end}`}>{formatPeriod(job.period)}</time>
            <div>
              <div class="runtime-entry-head">
                <h3>{job.company}</h3>
                <span class="runtime-location">{job.location}</span>
              </div>
              <p class="runtime-role">{job.role}</p>
              <ul>
                {job.onePageHighlights?.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </article>
        ))}

        <div class="runtime-phase" aria-hidden="true">
          <p>Earlier experience</p>
        </div>

        {earlierExperience.map((job) => (
          <article class="runtime-entry runtime-entry-compact">
            <time datetime={`${job.start}/${job.end}`}>{formatPeriod(job.period)}</time>
            <div>
              <div class="runtime-entry-head">
                <div class="runtime-compact-title">
                  <h3>{job.company}</h3>
                  <span>· {job.role}</span>
                </div>
                <span class="runtime-location">{job.location}</span>
              </div>
              <p class="runtime-compact-summary">{job.compactSummary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="runtime-capabilities" aria-labelledby="engineering-capability">
      <div>
        <h2 id="engineering-capability">Technical skills</h2>
        <dl class="runtime-skills">
          {resumeDraft.onePageSkills.map((group) => (
            <>
              <dt>{group.category}</dt>
              <dd>{group.items.join(", ")}</dd>
            </>
          ))}
        </dl>
      </div>

      <dl class="runtime-facts">
        <dt>Education</dt>
        {resumeDraft.education.map((education) => (
          <dd>
            BS Computer Science, {education.period} · {education.institution} · {education.location.replace(", Romania", "")}
          </dd>
        ))}

        <dt>Languages</dt>
        <dd>{resumeDraft.languages.map((language) => `${language.language} · ${language.level}`).join(" · ")}</dd>

        <dt>Availability</dt>
        <dd>{resumeDraft.availability[0]}</dd>
      </dl>
    </section>

    <footer class="runtime-footer">
      <span>Calin Gabriel · Curriculum vitae</span>
      <span>01 / 01</span>
    </footer>
  </section>
</main>

<script>
  const download = document.getElementById("download-runtime-pdf");
  if (download && location.port === "4321") {
    download.addEventListener("click", (event) => {
      event.preventDefault();
      window.print();
    });
  }
</script>
